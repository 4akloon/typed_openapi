                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ],
                          "description": "The format; null removes it."
                        },
                        "required": {
                          "type": "boolean",
                          "description": "Whether the property is required."
                        },
                        "items": {
                          "anyOf": [
                            {
                              "type": "object"
                            },
                            {
                              "type": "null"
                            }
                          ],
                          "description": "The schema of the items, as in the spec; null removes it."
                        },
                        "additionalProperties": {
