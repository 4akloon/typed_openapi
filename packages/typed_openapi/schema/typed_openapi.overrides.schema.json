                  },
                  "reconnect": {
                    "type": "boolean",
                    "description": "Whether this stream reconnects."
                  },
                  "method": {
                    "type": "string",
                    "enum": [
                      "stream",
                      "only",
                      "none"
                    ],
                    "description": "Which methods are generated: stream (the events beside the body), only (the events only) or none (leave the operation out)."
                  }
                },
                "additionalProperties": false,
                "description": "How the event stream of the operation is generated."
              }
            },
            "additionalProperties": false
          },
