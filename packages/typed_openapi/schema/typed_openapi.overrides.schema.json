                "description": "true, false or a schema, as in the spec; null removes it."
              },
              "enum": {
                "anyOf": [
                  {
                    "type": "array",
                    "items": {},
                    "minItems": 1
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "The allowed values; null removes them."
              },
              "discriminator": {
                "anyOf": [
                  {
                    "type": "object"
