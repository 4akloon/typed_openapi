                    "description": "A class with fromJson and toJson that converts the type, when the type itself has no such members."
                  }
                },
                "required": [
                  "type",
                  "import"
                ],
                "additionalProperties": false,
                "description": "Use this Dart type from a library. The schema does not check that a type or converter is not a reserved word of Dart."
              },
              "properties": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": {
