                              "type": "string",
                              "minLength": 1,
                              "pattern": "^(package:[A-Za-z_][A-Za-z0-9_]*/\\S+|dart:\\w+)$",
                              "description": "The package: or dart: library that declares the type."
                            },
                            "converter": {
                              "type": "string",
                              "minLength": 1,
                              "pattern": "^[A-Za-z$][A-Za-z0-9_$]*$",
                              "description": "A class with fromJson and toJson that converts the type, when the type itself has no such members."
                            }
