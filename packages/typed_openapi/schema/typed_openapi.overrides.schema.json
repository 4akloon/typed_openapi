                ],
                "description": "Response overrides by status or range, such as 200, 4XX or default."
              },
              "sse": {
                "type": "object",
                "properties": {
                  "data": {
                    "oneOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "object"
