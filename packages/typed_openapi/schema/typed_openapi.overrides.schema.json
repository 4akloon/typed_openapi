                  },
                  "contentType": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "/",
                    "description": "The media type to use, such as application/json. The schema checks only that it has a slash; the loader reads it as a media type."
                  },
                  "schema": {
                    "type": "object",
                    "description": "The schema of the body, written as in the spec."
                  }
                },
                "additionalProperties": false,
                "description": "The override of the request body."
              },
              "responses": {
                "anyOf": [
                  {
                    "type": "object",
