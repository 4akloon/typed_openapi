{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "typed_openapi overrides",
  "description": "The overrides file of a typed_openapi client.",
  "type": "object",
  "properties": {
    "operations": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1,
                "description": "Why the override exists; kept in the file for the reader, not used."
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "description": "The Dart name of the method."
              },
              "exclude": {
                "type": "boolean",
                "description": "Whether the operation is left out."
              },
              "group": {
                "type": "string",
                "minLength": 1,
                "description": "The class the method goes to, UpperCamelCase. The loader does not check the case; the generator reports a group that differs."
              },
              "parameters": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": {
                      "type": "object",
                      "properties": {
                        "reason": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Why the override exists; kept in the file for the reader, not used."
                        },
                        "required": {
                          "type": "boolean",
                          "description": "Whether the parameter is required."
                        },
                        "schema": {
                          "type": "object",
                          "description": "The schema of the parameter, written as in the spec."
                        },
                        "name": {
                          "type": "string",
                          "minLength": 1,
                          "description": "The Dart name of the argument."
                        },
                        "dartType": {
                          "type": "object",
                          "properties": {
                            "type": {
                              "type": "string",
                              "minLength": 1,
                              "pattern": "^[A-Za-z$][A-Za-z0-9_$]*$",
                              "description": "The Dart type, written as it is: no prefix and no type arguments, and not a reserved word (the schema cannot check the last)."
                            },
                            "import": {
                              "type": "string",
                              "minLength": 1,
                              "pattern": "^(package:[A-Za-z_][A-Za-z0-9_]*/\\S+|dart:\\w+)$",
                              "description": "The package: or dart: library that declares the type."
                            },
                            "converter": {
                              "type": "string",
                              "minLength": 1,
                              "pattern": "^[A-Za-z$][A-Za-z0-9_$]*$",
                              "description": "A class with fromJson and toJson that converts the type, when the type itself has no such members."
                            }
                          },
                          "required": [
                            "type",
                            "import"
                          ],
                          "additionalProperties": false,
                          "description": "Use this Dart type from a library. The schema does not check that a type or converter is not a reserved word of Dart."
